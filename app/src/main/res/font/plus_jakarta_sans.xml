<?xml version="1.0" encoding="utf-8"?>
<!-- Plus Jakarta Sans (SIL OFL 1.1, see /licenses), static weights cut from the official variable font.
     Android only reliably renders "normal" and "bold" from a family, so "bold" is mapped to the
     SemiBold cut: titles, names and buttons get a refined, not heavy, emphasis. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/plus_jakarta_sans_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/plus_jakarta_sans_medium" android:fontStyle="normal" android:fontWeight="500" />
    <font android:font="@font/plus_jakarta_sans_semibold" android:fontStyle="normal" android:fontWeight="600" />
    <font android:font="@font/plus_jakarta_sans_semibold" android:fontStyle="normal" android:fontWeight="700" />
</font-family>
