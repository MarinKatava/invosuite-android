<resources>
    <!-- Brand: calm deep teal, shading into cyan for gradients. Chosen to be easy on the eyes:
         moderate saturation, soft green-tinted neutrals, no pure-white page background.
         The invoice PDF uses the same teal accent. -->
    <color name="primary">#0F766E</color>
    <color name="primary_dark">#115E59</color>
    <color name="brand_secondary">#0E7490</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_container">#D5EFEA</color>
    <color name="on_primary_container">#083B36</color>

    <!-- Money / success. Same family as the brand so the app reads as one calm palette. -->
    <color name="accent">#0F766E</color>
    <color name="accent_container">#D5EFEA</color>
    <color name="on_accent">#FFFFFF</color>

    <!-- Neutrals: slightly green-tinted greys. -->
