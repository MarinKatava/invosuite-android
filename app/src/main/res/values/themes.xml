<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Forced Light (not DayNight): every color in colors.xml is a fixed
        light-theme value with no night variant. Under DayNight, a device in
        dark mode kept this light palette for surfaces/inputs but flipped
        Material's default text colors to white, making typed text invisible
        against the still-light TextInputEditText background. Pinning to
        Light keeps text/surface colors consistent with each other.
    -->
    <style name="Theme.InvoiSuite" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <!-- Drives the selected-tab pill and tonal buttons. -->
        <item name="colorSecondaryContainer">@color/primary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_primary_container</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/background</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="actionMenuTextColor">@color/primary</item>
        <item name="colorError">@color/error</item>
        <!-- No elevation tint: raised cards stay clean white instead of picking up a coloured cast. -->
        <item name="elevationOverlayEnabled">false</item>

        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="fontFamily">@font/plus_jakarta_sans</item>

        <item name="textAppearanceLabelLarge">@style/TextAppearance.InvoiSuite.LabelLarge</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Light system bars blend into the white app bar and bottom tabs. -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Sign-in / register screens open with a coloured banner, so the status bar matches it. -->
    <style name="Theme.InvoiSuite.Auth" parent="Theme.InvoiSuite">
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
